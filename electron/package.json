{
  "name": "captn-reverse-desktop",
  "version": "2.1.0",
  "description": "CaptnReverse Gaming Companion Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never"
  },
  "build": {
    "appId": "com.captnreverse.gaming-companion",
    "productName": "CaptnReverse Gaming Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../js/**/*",
      "../style.css",
      "../manifest.json",
      "../tests/test2.png"
    ],
    "extraResources": [
      {
        "from": "../icons",
        "to": "icons"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../icons/icon-256x256.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "icon": "../icons/icon-256x256.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../icons/icon-256x256.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CaptnReverse Gaming Companion"
    }
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.6.4"
  },
  "keywords": [
    "gaming",
    "ocr",
    "accessibility",
    "companion",
    "desktop"
  ],
  "author": "CaptnReverse Gaming Team",
  "license": "MIT"
}